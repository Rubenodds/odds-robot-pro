import streamlit as st
from odds_motor import autopilot_scanner, byg_kupon, liga_favoritter
from historik import gem_data

def vis_manuel_scanner():
    st.subheader("⚽ 2. Manuel Kamp Vælger")
    favs = tuple(liga_favoritter.hent_favorit_ligaer())
    timer = st.slider("⏱️ Tidsramme (timer):", 1, 72, 48, key="man_timer")
    kampe = [k for k in autopilot_scanner._hent_kampe_v9(favs) if 0 < k["timer"] <= timer]
    ligaer = sorted({k["liga"] for k in kampe})
    valgte_ligaer = st.multiselect("🏆 Vælg ligaer (blank fra start):", ligaer, default=[], key="man_ligaer")
    pulje = [k for k in kampe if k["liga"] in valgte_ligaer] if valgte_ligaer else kampe
    hold = sorted({k["hj"] for k in pulje} | {k["ud"] for k in pulje})
    valgt_hold = st.selectbox("🔍 Søg hold:", [""] + hold, key="man_hold")
    udfald = st.text_input("🎯 Spil / marked:", placeholder="F.eks. Over 2.5 mål", key="man_udf")
    odds = st.number_input("💰 Odds:", min_value=1.01, value=2.00, step=0.10, key="man_odds")
    if valgt_hold and udfald:
        pct = byg_kupon.beregn_sandsynlighed_fra_odds(odds)
        st.info(f"Vinderchance: **{pct}%** | {'⭐' * (5 if pct >= 70 else 3)}")
    if st.button("🚀 SPILLET", type="primary", key="btn_man_spil") and valgt_hold and udfald:
        if gem_data.gem_kupon_i_historik(valgte_ligaer or ["Manuel"], [f"{valgt_hold}: {udfald}"], odds, odds, odds, "Manuel", 4, 100.0):
            st.success("Gemt i Supabase!")
